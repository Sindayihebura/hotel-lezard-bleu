# ============================================================
# Hôtel Le Lézard Bleu & Spa — Configuration d'environnement
# Bujumbura, Burundi | Lac Tanganyika
# ============================================================
# IMPORTANT : Ne jamais committer le fichier .env réel.
# Copier ce fichier en .env et remplir les valeurs.
# ============================================================

# ---- APPLICATION ----
APP_ENV=development
APP_DEBUG=false
APP_URL=https://lezardbleu-hotel.bi
APP_NAME="Hotel Le Lezard Bleu & Spa"
APP_TIMEZONE=Africa/Bujumbura
APP_SECRET_KEY=

# ---- BASE DE DONNÉES ----
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hotel_lezardbleu
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---- SESSION SÉCURISÉE ----
SESSION_NAME=__Host-lezard_session
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax
SESSION_LIFETIME=7200

# ---- DEVISES (BIF principal / USD secondaire) ----
CURRENCY_BASE=BIF
CURRENCY_DEFAULT=BIF
SUPPORTED_CURRENCIES=BIF,USD
DEFAULT_EXCHANGE_RATE=6000

# ---- PAIEMENTS ----
PAYMENT_PROVIDER=manual
PAYMENT_ENV=sandbox

# Lumicash (Lumitel) — remplir depuis doc officielle uniquement
LUMICASH_MERCHANT_ID=
LUMICASH_API_KEY=
LUMICASH_API_SECRET=
LUMICASH_WEBHOOK_SECRET=
LUMICASH_API_BASE_URL=

# EcoCash (Econet Leo Burundi) — remplir depuis doc officielle
ECOCASH_MERCHANT_ID=
ECOCASH_API_KEY=
ECOCASH_API_SECRET=
ECOCASH_WEBHOOK_SECRET=
ECOCASH_API_BASE_URL=

# EasyPay — remplir depuis doc officielle
EASYPAY_MERCHANT_ID=
EASYPAY_API_KEY=
EASYPAY_API_SECRET=
EASYPAY_WEBHOOK_SECRET=
EASYPAY_API_BASE_URL=

# PayPal (optionnel)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# ---- EMAIL (SMTP) ----
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=reservation@lezardbleu-hotel.bi
MAIL_FROM_NAME="Le Lezard Bleu Hotel"

# ---- SMS / WHATSAPP ----
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=LezardBleu
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# ---- SÉCURITÉ ----
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_MIN_LENGTH=10
ADMIN_MFA_REQUIRED=true
RATE_LIMIT_PER_MINUTE=60

# ---- LOGS ----
LOG_CHANNEL=file
LOG_LEVEL=warning
LOG_PATH=storage/logs/app.log
AUDIT_LOG_PATH=storage/logs/audit.log

# ---- STOCKAGE ----
STORAGE_PATH=storage/private
BACKUP_PATH=storage/backups

# ---- MULTILINGUE ----
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,en,rn

# ---- HOTEL ----
HOTEL_NAME="Hotel Le Lezard Bleu & Spa"
HOTEL_PHONE="+257 22 00 00 00"
HOTEL_EMAIL=contact@lezardbleu-hotel.bi
HOTEL_ADDRESS="Avenue de la Plage, Bujumbura, Burundi"
HOTEL_CHECKIN_TIME=14:00
HOTEL_CHECKOUT_TIME=11:00
HOTEL_CANCELLATION_HOURS=48
