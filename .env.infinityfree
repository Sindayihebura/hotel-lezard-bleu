# Copie ce fichier en .env et remplis tes vraies valeurs InfinityFree
# NE PAS uploader ce fichier tel quel — remplacer les valeurs d'abord

APP_ENV=production
APP_DEBUG=false
APP_URL=http://TON-SOUS-DOMAINE.infinityfreeapp.com

# --- Remplis avec les infos MySQL de InfinityFree ---
DB_HOST=sql.infinityfree.com
DB_PORT=3306
DB_DATABASE=epiz_XXXXXXXX_hotel
DB_USERNAME=epiz_XXXXXXXX
DB_PASSWORD=TON_MOT_DE_PASSE_DB

SESSION_NAME=lezard_session
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax
SESSION_LIFETIME=7200

CURRENCY_BASE=BIF
CURRENCY_DEFAULT=BIF
SUPPORTED_CURRENCIES=BIF,USD
DEFAULT_EXCHANGE_RATE=6000

PAYMENT_PROVIDER=manual
PAYMENT_ENV=sandbox

MAIL_FROM_ADDRESS=contact@lezardbleu-hotel.bi
MAIL_FROM_NAME="Le Lezard Bleu Hotel"

DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,en,rn

APP_TIMEZONE=Africa/Bujumbura
PASSWORD_MIN_LENGTH=10
BCRYPT_COST=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ADMIN_MFA_REQUIRED=false
RATE_LIMIT_PER_MINUTE=60
