# =====================================================================
# .gitignore — Hôtel Le Lézard Bleu & Spa
# =====================================================================

# ── Secrets — ne JAMAIS committer ─────────────────────────────────────
.env
*.env.local
*.env.*.local
# Garder les fichiers d'exemple (pas de vraies valeurs dedans)
!.env.example
!.env.railway
!.env.infinityfree

# ── Dépendances Node (Netlify les réinstalle au build via npm install) ─
node_modules/

# ── Dépendances Composer PHP ──────────────────────────────────────────
/vendor/
composer.lock

# ── Netlify CLI — fichiers locaux (NE PAS déployer) ───────────────────
# .netlify/ contient des chemins absolus locaux générés par netlify link
# Ce dossier est recréé automatiquement par netlify dev / netlify link
.netlify/
# Sauf le state.json qui identifie le site lié (optionnel)
# !.netlify/state.json

# ── Sous-repo git imbriqué ────────────────────────────────────────────
hotel-lezard-bleu/

# ── Logs et cache ─────────────────────────────────────────────────────
/storage/logs/*.log
/storage/cache/*
/storage/backups/*
/storage/private/*
!/storage/logs/.gitkeep
!/storage/cache/.gitkeep
!/storage/backups/.gitkeep
!/storage/private/.gitkeep

# ── IDE ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── PHP ───────────────────────────────────────────────────────────────
*.phar

# ── Tests ─────────────────────────────────────────────────────────────
/coverage/
.phpunit.result.cache

# ── Fichiers générés au build ─────────────────────────────────────────
# dist/env-config.js est généré par generate-env-config.js au build Netlify.
# La clé SUPABASE_ANON_KEY est une clé PUBLIQUE (publishable) — ok à committer.
# On la garde committée pour le mode local (sans build step).
# dist/env-config.js

# ── Divers ────────────────────────────────────────────────────────────
*.log
*.tmp
*.temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
