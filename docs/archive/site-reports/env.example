# ====================================================================
# VARIABLES D'ENVIRONNEMENT - HÔTEL LE LÉZARD BLEU
# ====================================================================
# Copiez ce fichier en .env.local pour le développement local
# Pour Netlify, configurez ces variables dans l'interface Netlify

# ====================================================================
# SUPABASE (Base de données & Authentification)
# ====================================================================
# Obtenez ces valeurs depuis https://supabase.com
# Projet > Settings > API

SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ====================================================================
# APPLICATION
# ====================================================================
APP_NAME="Hôtel Le Lézard Bleu & Spa"
APP_URL=https://hotel-lezard-bleu.netlify.app
APP_ENV=production

# ====================================================================
# DEVISES & PAIEMENTS
# ====================================================================
DEFAULT_EXCHANGE_RATE=6000
# 1 USD = 6000 BIF (ajustez selon le taux actuel)

DEFAULT_CURRENCY=BIF
SUPPORTED_CURRENCIES=BIF,USD

# ====================================================================
# EMAIL (Optionnel - pour les notifications)
# ====================================================================
# Utilisez SendGrid, Mailgun, ou Amazon SES

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=votre_clé_api_sendgrid

EMAIL_FROM=contact@lezardbleu-hotel.bi
EMAIL_FROM_NAME="Hôtel Le Lézard Bleu"

# ====================================================================
# PAIEMENTS (À configurer selon vos besoins)
# ====================================================================

# Lumicash (Mobile Money Burundi)
LUMICASH_MERCHANT_ID=
LUMICASH_API_KEY=

# EcoCash (Mobile Money Burundi)
ECOCASH_MERCHANT_ID=
ECOCASH_API_KEY=

# Stripe (Cartes internationales)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ====================================================================
# SÉCURITÉ
# ====================================================================
JWT_SECRET=votre_secret_jwt_très_sécurisé_ici

# Limite de requêtes par IP (par minute)
RATE_LIMIT_PER_MINUTE=60

# ====================================================================
# FONCTIONNALITÉS
# ====================================================================
ENABLE_REVIEWS=true
ENABLE_NEWSLETTER=true
ENABLE_CHAT_WIDGET=false

# ====================================================================
# ANALYTICS (Optionnel)
# ====================================================================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
FACEBOOK_PIXEL_ID=

# ====================================================================
# NOTES DE CONFIGURATION
# ====================================================================
# 
# DÉVELOPPEMENT LOCAL :
# 1. Copiez ce fichier : cp .env.example .env.local
# 2. Remplissez vos vraies valeurs
# 3. Lancez : netlify dev
#
# DÉPLOIEMENT NETLIFY :
# 1. Allez dans Site settings > Environment variables
# 2. Ajoutez chaque variable manuellement
# 3. Redéployez le site
#
# OBLIGATOIRE pour le fonctionnement :
# - SUPABASE_URL
# - SUPABASE_ANON_KEY
# - DEFAULT_EXCHANGE_RATE
#
# RECOMMANDÉ :
# - Variables email (pour les confirmations)
# - Variables de paiement (selon vos méthodes)
#
# ====================================================================
