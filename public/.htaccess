# ============================================================
# Hôtel Le Lézard Bleu & Spa — Apache Configuration
# Dossier public uniquement
# ============================================================

# ── Moteur de réécriture ──────────────────────────────────────────────────
Options -Indexes
Options -ExecCGI

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /public/

    # Forcer HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Fichiers et dossiers existants — servir directement
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Router API v1
    RewriteRule ^api/v1/(.*)$ api/v1/index.php?route=$1 [L,QSA]
</IfModule>

# ── Headers de sécurité HTTP ─────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# ── Bloquer l'accès aux fichiers sensibles ────────────────────────────────
<FilesMatch "\.(env|log|sql|sh|bak|backup|conf|ini|json|lock|md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── PHP — sécurisation ────────────────────────────────────────────────────
<IfModule mod_php.c>
    php_flag expose_php off
    php_flag display_errors off
    php_flag display_startup_errors off
    php_flag log_errors on
    php_flag session.cookie_httponly on
    php_flag session.cookie_secure on
    php_flag session.use_only_cookies on
    php_flag session.use_strict_mode on
    php_value session.cookie_samesite "Lax"
</IfModule>

# ── Cache navigateur (assets statiques) ──────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# ── Compression ───────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
